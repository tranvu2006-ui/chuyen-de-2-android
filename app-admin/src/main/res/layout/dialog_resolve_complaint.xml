<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_circle_icon_red">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_shield_alert"
                    app:tint="@color/danger" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Phán Quyết Khiếu Nại Đơn Hàng"
                    android:textColor="@color/text_primary"
                    android:textSize="17.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDialogComplaintRef"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    tools:text="Đơn: ORD-123 • Quán: store_01" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvDialogReasonContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_search_bar_modern"
            android:padding="14dp"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            tools:text="Nội dung: Món giao thiếu và không đạt chất lượng." />

        <!-- Decision Group -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="1. PHÁN QUYẾT HỒ SƠ KHIẾU NẠI:"
            android:textColor="@color/secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgComplaintDecision"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">

            <RadioButton
                android:id="@+id/rbResolveApprove"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="✅ Chấp thuận khiếu nại chính đáng (RESOLVED)"
                android:textColor="@color/brand_green"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/rbResolveReject"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="❌ Bác bỏ khiếu nại không đủ căn cứ (REJECTED)"
                android:textColor="@color/danger"
                android:textSize="13sp"
                android:textStyle="bold" />
        </RadioGroup>

        <!-- Store Penalty Tier -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="2. MỨC CHẾ TÀI ĐỐI VỚI CỬA HÀNG:"
            android:textColor="@color/secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgComplaintPenalty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">

            <RadioButton
                android:id="@+id/rbPenaltyNone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="⚪ Không áp dụng phạt (NONE)"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rbPenaltyWarn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🟡 Mức 1: Cảnh cáo vi phạm (WARN)"
                android:textColor="@color/brand_orange"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rbPenaltyHide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🟠 Mức 2: Ẩn quán khỏi đề xuất 3 ngày (HIDE)"
                android:textColor="@color/brand_orange"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rbPenaltyLock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔴 Mức 3: Đình chỉ &amp; Khóa quyền bán (LOCK)"
                android:textColor="@color/danger"
                android:textSize="13sp"
                android:textStyle="bold" />
        </RadioGroup>

        <!-- Admin Note -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilAdminNote"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="3. Kết luận &amp; Ghi chú của Quản trị viên"
            app:boxBackgroundColor="@color/surface_elevated"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAdminNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lines="2"
                android:textSize="13.5sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelResolve"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Hủy bỏ"
                android:textColor="@color/text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitResolve"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="@color/primary"
                android:text="BAN HÀNH PHÁN QUYẾT"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:cornerRadius="12dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
