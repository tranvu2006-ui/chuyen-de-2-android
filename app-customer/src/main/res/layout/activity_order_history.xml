<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- ===================================================
         1. TOP HEADER (b3.html: top-header)
         =================================================== -->
    <LinearLayout
        android:id="@+id/layoutTopHeader"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/white"
        android:elevation="1dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnNavBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_btn_circle_nav"
            android:contentDescription="Quay lại"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#1E293B" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Đơn Hàng Của Tôi"
            android:textColor="#1E293B"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCustomerNameHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Khách: Bạn"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ===================================================
         2. TABS BAR CUỘN NGANG VỚI BADGE COUNT (b3.html: tabs-bar)
         =================================================== -->
    <HorizontalScrollView
        android:id="@+id/scrollTabsBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="1dp"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/layoutTopHeader">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupTabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            app:singleLine="true"
            app:singleSelection="true">

            <!-- Tab 1: Tất cả -->
            <com.google.android.material.chip.Chip
                android:id="@+id/tabAll"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Tất cả"
                android:textSize="11.5sp" />

            <!-- Tab 2: 🚨 Bị cảnh báo -->
            <com.google.android.material.chip.Chip
                android:id="@+id/tabWarning"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚨 Bị cảnh báo (0)"
                android:textColor="#DC2626"
                android:textSize="11.5sp" />

            <!-- Tab 3: Đang đến -->
            <com.google.android.material.chip.Chip
                android:id="@+id/tabActive"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đang đến (0)"
                android:textSize="11.5sp" />

            <!-- Tab 4: 🚫 Đã hủy -->
            <com.google.android.material.chip.Chip
                android:id="@+id/tabCancelled"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚫 Đã hủy (0)"
                android:textSize="11.5sp" />

            <!-- Tab 5: Chờ thanh toán -->
            <com.google.android.material.chip.Chip
                android:id="@+id/tabUnpaid"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chờ thanh toán (0)"
                android:textSize="11.5sp" />

            <!-- Tab 6: Chờ xác nhận -->
            <com.google.android.material.chip.Chip
                android:id="@+id/tabConfirming"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chờ xác nhận (0)"
                android:textSize="11.5sp" />

            <!-- Tab 7: Đã xong -->
            <com.google.android.material.chip.Chip
                android:id="@+id/tabHistory"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đã xong"
                android:textSize="11.5sp" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Đường viền mỏng ngăn cách -->
    <View
        android:id="@+id/dividerTabs"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E2E8F0"
        app:layout_constraintTop_toBottomOf="@id/scrollTabsBar" />

    <!-- ===================================================
         3. BANNER NHẮC NHỞ CẢNH BÁO KHẨN CẤP (b3.html: Banner đỏ)
         =================================================== -->
    <LinearLayout
        android:id="@+id/layoutEmergencyWarningBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FEF2F2"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/dividerTabs">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚨"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvEmergencyWarningTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Có đơn đang bị tài xế cảnh báo mất đơn!"
                android:textColor="#DC2626"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đang đếm ngược 15P chờ bạn nhận món kẻo bị hủy"
                android:textColor="#991B1B"
                android:textSize="10sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnViewWarningNow"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:backgroundTint="#DC2626"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="10dp"
            android:text="Xem Ngay ➔"
            android:textColor="@color/white"
            android:textSize="10.5sp"
            android:textStyle="bold"
            app:cornerRadius="8dp" />
    </LinearLayout>

    <!-- ===================================================
         4. RECYCLER VIEW DANH SÁCH ĐƠN HÀNG
         =================================================== -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvOrders"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingVertical="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutEmergencyWarningBanner"
        tools:listitem="@layout/item_order_history" />

    <!-- Empty State thông báo khi không có đơn -->
    <LinearLayout
        android:id="@+id/layoutEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dividerTabs">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📦"
            android:textSize="48sp" />

        <TextView
            android:id="@+id/tvEmptyMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Không có đơn hàng nào trong mục này"
            android:textColor="#64748B"
            android:textSize="13.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutTopHeader" />

</androidx.constraintlayout.widget.ConstraintLayout>
