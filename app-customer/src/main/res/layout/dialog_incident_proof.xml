<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Handle bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="#CBD5E1" />

    <!-- Header: Biểu tượng + Tiêu đề + Nút đóng (b3.html: modal-card top) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📋"
            android:textSize="22sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CHI TIẾT CẢNH BÁO SỰ CỐ"
                android:textColor="#DC2626"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvModalOrderCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="#ORD_OISHI_88291 • Ghi nhận hệ thống"
                android:textColor="#64748B"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnModalClose"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_btn_circle_nav"
            android:contentDescription="Đóng"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#64748B" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E2E8F0" />

    <!-- Khung chính sách bảo vệ -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="#FFFBEB"
        android:lineSpacingExtra="2dp"
        android:padding="8dp"
        android:text="⚠️ Quy trình bảo vệ khách hàng &amp; tài xế: Đơn hàng đang được đếm ngược 15 phút tại điểm giao. Vui lòng nhận món hoặc xuất trình mã QR để nhận hàng."
        android:textColor="#92400E"
        android:textSize="11sp" />

    <!-- Chi tiết thông tin biên bản -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <!-- Dòng lý do sự cố -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="6dp">

            <TextView
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:text="Lý do sự cố:"
                android:textColor="#64748B"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvModalReason"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Khách không nghe máy sau 15 phút cảnh báo (Bom hàng)"
                android:textColor="#DC2626"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Dòng tài xế giao hàng -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="6dp">

            <TextView
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:text="Tài xế giao hàng:"
                android:textColor="#64748B"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvModalDriverInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Trần Văn Nam (TX-19)"
                android:textColor="#0F172A"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Dòng đếm ngược -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="6dp">

            <TextView
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:text="Thời gian đếm ngược:"
                android:textColor="#64748B"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvModalCountdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#FEF2F2"
                android:fontFamily="monospace"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="14:45 (Đang đếm ngược)"
                android:textColor="#DC2626"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Ảnh chụp bằng chứng hiện trường -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="4dp"
            android:text="Ảnh chụp bằng chứng cuộc gọi / hiện trường:"
            android:textColor="#64748B"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivModalProof"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:background="#F1F5F9"
            android:scaleType="centerCrop"
            android:src="@drawable/placeholder_food" />

        <!-- Ghi chú tài xế -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#F8FAFC"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ghi chú của tài xế:"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvModalDriverNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="&quot;Đã đứng đợi tại điểm giao, gọi 3 cuộc đổ chuông nhưng không có người nhấc máy. Hệ thống đang kích hoạt đếm ngược 15 phút.&quot;"
                android:textColor="#334155"
                android:textSize="11.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Nút hành động chân modal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnModalTakeAction"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:backgroundTint="#DC2626"
            android:text="Lấy Mã QR Quét Ngay ➔"
            android:textColor="@color/white"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnModalDismiss"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:text="Đóng"
            android:textColor="#475569"
            android:textSize="12.5sp" />
    </LinearLayout>

</LinearLayout>
