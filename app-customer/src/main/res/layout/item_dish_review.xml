<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_stepper_box"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header bình luận: Avatar tròn, Tên, Ngày, Sao -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvAvatarCircle"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_btn_circle_nav"
            android:gravity="center"
            android:text="K"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCustomerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#0F172A"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvStars"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="★★★★★"
                    android:textColor="@color/rating_star"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvReviewDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="#94A3B8"
                    android:textSize="10.5sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Tag tùy chọn món khi mua -->
    <TextView
        android:id="@+id/tvSpecTag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_spec_pill"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:text="Size L • 50% Đường • 70% Đá"
        android:textColor="@color/primary"
        android:textSize="10sp"
        android:textStyle="bold" />

    <!-- Nội dung bình luận cảm nhận -->
    <TextView
        android:id="@+id/tvReviewComment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="2dp"
        android:textColor="#334155"
        android:textSize="12sp" />

    <!-- Ảnh món ăn do khách hàng gửi kèm (b5.html) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardReviewImage"
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:cardCornerRadius="10dp"
        app:strokeColor="@color/border"
        app:strokeWidth="1dp">

        <ImageView
            android:id="@+id/ivReviewImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Nút Like / Hữu ích -->
    <LinearLayout
        android:id="@+id/btnLikeReview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="4dp">

        <TextView
            android:id="@+id/tvLikeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👍 Hữu ích"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLikeCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="(0)"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
