<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardHomeDish"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- 1. Ảnh / Icon món ăn (78x78dp) + Badge Promo (Theo chuẩn b1.html dish-food-img) -->
        <FrameLayout
            android:id="@+id/flDishThumb"
            android:layout_width="78dp"
            android:layout_height="78dp"
            android:background="@drawable/bg_search_box"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivDishThumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/placeholder_food" />

            <TextView
                android:id="@+id/tvDishEmoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="🍲"
                android:textSize="36sp"
                android:visibility="gone" />

            <!-- Badge khuyến mãi góc trái trên (b1.html: dish-badge-promo) -->
            <TextView
                android:id="@+id/tvDishPromo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:background="@drawable/bg_badge_orange"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1.5dp"
                android:text="-50%"
                android:textColor="@color/white"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="visible" />
        </FrameLayout>

        <!-- 2. Thông tin chi tiết món ăn (b1.html: dish-food-info) -->
        <LinearLayout
            android:id="@+id/llDishInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnAddDish"
            app:layout_constraintStart_toEndOf="@id/flDishThumb"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Tên món ăn -->
            <TextView
                android:id="@+id/tvDishName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Hồng Trà Sữa Trân Châu Hoàng Kim"
                android:textColor="#1E293B"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <!-- Hàng giá tiền: Giá bán cam + Giá cũ gạch ngang -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvDishPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="28.000 đ"
                    android:textColor="@color/primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDishOldPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="56.000 đ"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:visibility="visible" />
            </LinearLayout>

            <!-- Tên quán bán món -->
            <TextView
                android:id="@+id/tvStoreName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="🏪 Hồng Trà Ngô Gia - 28 Tô Vĩnh Diện"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Meta: Đánh giá + Cự ly km -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvRatingMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⭐ 4.8 (1.2k đã bán)"
                    android:textColor="#D97706"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDistanceMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="• 📍 1.2 km"
                    android:textColor="#047857"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Tag nhãn phụ: Bán Chạy Nhất, Freeship Extra -->
            <LinearLayout
                android:id="@+id/layoutTags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTag1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#FFF0ED"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1.5dp"
                    android:text="Bán Chạy Nhất"
                    android:textColor="@color/primary"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTag2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:background="#ECFDF5"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1.5dp"
                    android:text="Freeship Extra"
                    android:textColor="#10B981"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

        <!-- 3. Nút tròn '+' màu cam gradient để thêm món (b1.html: btn-dish-add) -->
        <FrameLayout
            android:id="@+id/btnAddDish"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_floating_cart"
            android:clickable="true"
            android:elevation="2dp"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="+"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
