<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeColor="#F1F5F9"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <!-- Icon Container tròn -->
        <FrameLayout
            android:id="@+id/flNotifIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_badge_orange">

            <ImageView
                android:id="@+id/ivNotifIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                app:srcCompat="@drawable/ic_notification"
                app:tint="@color/primary" />
        </FrameLayout>

        <!-- Nội dung thông báo -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvNotifTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Cập nhật đơn hàng"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Chấm xanh chưa đọc -->
                <View
                    android:id="@+id/viewUnreadDot"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_dot_online" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvNotifBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp"
                android:maxLines="2"
                android:text="Tài xế đang giao đơn hàng đến bạn. Vui lòng chú ý điện thoại."
                android:textColor="#475569"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/tvNotifTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Vừa xong"
                android:textColor="#64748B"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Chevron right icon -->
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="8dp"
            app:srcCompat="@drawable/ic_chevron_right"
            app:tint="@color/text_muted" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
