<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="7dp">

    <!-- Tên món và ghi chú tùy chọn -->
    <LinearLayout
        android:id="@+id/layoutDishInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/layoutQtyAndPrice"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvDishName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/on_background"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="Trà Ô Long Sữa (L) x1" />

        <TextView
            android:id="@+id/tvDishNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="50% đường, ít đá"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- Bộ điều chỉnh số lượng và đơn giá -->
    <LinearLayout
        android:id="@+id/layoutQtyAndPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Nút giảm -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDecrease"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="−"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="6dp"
            app:strokeColor="@color/border"
            app:strokeWidth="1dp" />

        <TextView
            android:id="@+id/tvQuantity"
            android:layout_width="26dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="1" />

        <!-- Nút tăng -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnIncrease"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="+"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="6dp"
            app:strokeColor="@color/border"
            app:strokeWidth="1dp" />

        <!-- Giá tiền món -->
        <TextView
            android:id="@+id/tvDishPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textColor="@color/on_background"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="55.000₫" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
