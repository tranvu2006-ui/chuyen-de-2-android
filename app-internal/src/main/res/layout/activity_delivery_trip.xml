<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Top App Bar (4.html: driver-navbar) -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarTrip"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="12dp">

            <ImageButton
                android:id="@+id/btnTripBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_badge_duty_off"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="@color/text_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTripOrderCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="#ORD_OISHI_88291"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đơn nội bộ quán"
                    android:textColor="@color/brand_blue"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTripCancel"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:paddingHorizontal="10dp"
                android:text="✕ Hủy đơn"
                android:textColor="@color/danger"
                android:textSize="11.5sp"
                app:strokeColor="#FECDD3" />
        </LinearLayout>
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- Stepper 4 Bước Lộ Trình (4.html, 5.html, 6.html, 8.html) -->
    <LinearLayout
        android:id="@+id/layoutTripStepper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        app:layout_constraintTop_toBottomOf="@id/toolbarTrip">

        <!-- Bước 1 -->
        <TextView
            android:id="@+id/step1Badge"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/bg_badge_orange"
            android:gravity="center"
            android:text="1"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/step1Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="Đến Quán"
            android:textColor="@color/primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/stepDiv1"
            android:layout_width="0dp"
            android:layout_height="1.5dp"
            android:layout_marginHorizontal="6dp"
            android:layout_weight="1"
            android:background="#E2E8F0" />

        <!-- Bước 2 -->
        <TextView
            android:id="@+id/step2Badge"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/bg_badge_duty_off"
            android:gravity="center"
            android:text="2"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/step2Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="Lấy Hàng"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <View
            android:id="@+id/stepDiv2"
            android:layout_width="0dp"
            android:layout_height="1.5dp"
            android:layout_marginHorizontal="6dp"
            android:layout_weight="1"
            android:background="#E2E8F0" />

        <!-- Bước 3 -->
        <TextView
            android:id="@+id/step3Badge"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/bg_badge_duty_off"
            android:gravity="center"
            android:text="3"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/step3Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="Đến Khách"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <View
            android:id="@+id/stepDiv3"
            android:layout_width="0dp"
            android:layout_height="1.5dp"
            android:layout_marginHorizontal="6dp"
            android:layout_weight="1"
            android:background="#E2E8F0" />

        <!-- Bước 4 -->
        <TextView
            android:id="@+id/step4Badge"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/bg_badge_duty_off"
            android:gravity="center"
            android:text="4"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/step4Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="Giao Xong"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/layoutBottomAction"
        app:layout_constraintTop_toBottomOf="@id/layoutTripStepper">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp">

            <!-- CHẶNG 1: Đến Quán Lấy Món (4.html) -->
            <LinearLayout
                android:id="@+id/layoutStep1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Hộp Navigation Xanh Dương -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Material3.CardView.Elevated"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#1A73E8"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="3dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="↗"
                            android:textColor="#FFFFFF"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvStep1NavInstruction"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Cách quán 850m • Rẽ phải vào Võ Văn Ngân"
                                android:textColor="#FFFFFF"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Thời gian dự kiến: ~3 phút"
                                android:textColor="#DBEAFE"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnOpenNavStep1"
                            style="@style/Widget.Material3.Button.ElevatedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:backgroundTint="#FFFFFF"
                            android:paddingHorizontal="10dp"
                            android:text="Maps ➔"
                            android:textColor="#1A73E8"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Thẻ Thông Tin Quán -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Material3.CardView.Elevated"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvStep1StoreName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Trà Sữa Ngô Gia (CN Võ Văn Ngân)"
                                    android:textColor="@color/text_primary"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="● Quán đã sẵn sàng giao món"
                                    android:textColor="@color/brand_green"
                                    android:textSize="11.5sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnCallStoreStep1"
                                style="@style/Widget.Material3.Button.ElevatedButton"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:backgroundTint="#ECFDF5"
                                android:insetLeft="0dp"
                                android:insetTop="0dp"
                                android:insetRight="0dp"
                                android:insetBottom="0dp"
                                android:text="📞"
                                android:textColor="@color/brand_green"
                                app:cornerRadius="20dp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvStep1StoreAddress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_badge_duty_off"
                            android:padding="10dp"
                            android:text="📍 Địa chỉ: 120 Võ Văn Ngân, P. Linh Chiểu, TP. Thủ Đức"
                            android:textColor="#334155"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvStep1DishesList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:lineSpacingExtra="2dp"
                            android:text="📦 Món cần lấy:\n• 1x Trà Ô Long (Size M)\n• 1x Trà Ngô Gia (Size M)"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- CHẶNG 2: Xác Nhận Lấy Hàng Checklist Tại Quán (5.html) -->
            <LinearLayout
                android:id="@+id/layoutStep2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Alert Đã Đến Quán -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Material3.CardView.Elevated"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#ECFDF5"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#A7F3D0"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🏪"
                            android:textSize="26sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Đã đến quán Trà Sữa Ngô Gia"
                                android:textColor="#065F46"
                                android:textSize="13.5sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Vui lòng đối chiếu checklist món trước khi xuất phát giao"
                                android:textColor="#047857"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Checklist món ăn -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Material3.CardView.Elevated"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Kiểm tra món ăn của đơn"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnCheckAllDishes"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:text="✓ Chọn tất cả"
                                android:textColor="@color/brand_blue"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <CheckBox
                            android:id="@+id/cbDish1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="1x Trà Ô Long (Size M) - 100% đường, 50% đá"
                            android:textColor="#1E293B"
                            android:textSize="12.5sp" />

                        <CheckBox
                            android:id="@+id/cbDish2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="1x Trà Ngô Gia (Size M) - Trân châu hoàng kim"
                            android:textColor="#1E293B"
                            android:textSize="12.5sp" />

                        <CheckBox
                            android:id="@+id/cbSealPackage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="Túi niêm phong đã dán tem nguyên vẹn"
                            android:textColor="#059669"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- CHẶNG 3: Đến Điểm Giao Khách (6.html) -->
            <LinearLayout
                android:id="@+id/layoutStep3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Hộp Navigation Xanh Lá -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Material3.CardView.Elevated"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#059669"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="3dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="➔"
                            android:textColor="#FFFFFF"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvStep3NavInstruction"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Cách khách 1.2km • Rẽ trái vào Hai Bà Trưng"
                                android:textColor="#FFFFFF"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Dự kiến giao đến trong: 5 phút"
                                android:textColor="#A7F3D0"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnOpenNavStep3"
                            style="@style/Widget.Material3.Button.ElevatedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:backgroundTint="#FFFFFF"
                            android:paddingHorizontal="10dp"
                            android:text="Maps ➔"
                            android:textColor="#059669"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Thẻ Thông Tin Khách Hàng -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Material3.CardView.Elevated"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvStep3CustomerName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="An Nguyễn"
                                    android:textColor="@color/text_primary"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvStep3CustomerPhone"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="0938 112 233"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnCallCustomerStep3"
                                style="@style/Widget.Material3.Button.ElevatedButton"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:backgroundTint="#ECFDF5"
                                android:insetLeft="0dp"
                                android:insetTop="0dp"
                                android:insetRight="0dp"
                                android:insetBottom="0dp"
                                android:text="📞"
                                android:textColor="@color/brand_green"
                                app:cornerRadius="20dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnMessageCustomerStep3"
                                style="@style/Widget.Material3.Button.ElevatedButton"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_marginStart="8dp"
                                android:backgroundTint="#EFF6FF"
                                android:insetLeft="0dp"
                                android:insetTop="0dp"
                                android:insetRight="0dp"
                                android:insetBottom="0dp"
                                android:text="💬"
                                android:textColor="@color/brand_blue"
                                app:cornerRadius="20dp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvStep3DeliveryAddress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_badge_duty_off"
                            android:padding="10dp"
                            android:text="📍 Địa chỉ: 104 Hai Bà Trưng, P. Đa Kao, Q.1"
                            android:textColor="#1E293B"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvStep3PaymentMethodBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="#FEF2F2"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="💵 Thu tiền mặt COD: 95.000 đ"
                            android:textColor="@color/danger"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- CHẶNG 4: Quét QR & Hoàn Tất Giao Hàng (8.html) -->
            <LinearLayout
                android:id="@+id/layoutStep4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Thẻ Thông Tin Đối Soát -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Material3.CardView.Elevated"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ĐỐI SOÁT HOÀN TẤT GIAO HÀNG"
                            android:textColor="@color/brand_green"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvStep4CodCollection"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Thu Tiền Mặt COD: 95.000 đ"
                            android:textColor="@color/danger"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvStep4Summary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
