<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
           
            app:srcCompat="@drawable/ic_alert_triangle" app:tint="#F59E0B" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BÁO CÁO SỰ CỐ &amp; HỦY ĐƠN"
                android:textColor="@color/danger"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvIncidentOrderSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Đơn hàng: #ORD-..."
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnCloseIncidentDialog"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_badge_duty_off"
            android:src="@drawable/ic_close"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <!-- Policy note -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_warning_inline"
        android:orientation="horizontal"
        android:padding="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ℹ️"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="Chính sách Oishi Food: Tài xế cung cấp bằng chứng sự cố (ảnh hiện trường / lịch sử 3 cuộc gọi) sẽ không bị phạt và được hỗ trợ quyền lợi đầy đủ."
            android:textColor="#92400E"
            android:textSize="11sp"
            android:lineSpacingExtra="2dp" />
    </LinearLayout>

    <!-- Chọn lý do -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="4dp"
        android:text="Lý do gặp sự cố: *"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spinnerIncidentReason"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_rounded_spinner_border"
        android:paddingHorizontal="10dp" />

    <!-- Chụp ảnh bằng chứng -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        android:text="Ảnh bằng chứng sự cố:"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/btnAttachProof"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_badge_duty_off"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="14dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/tvProofIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📸"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/tvProofText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Chạm vào đây để đính kèm ảnh hiện trường / lịch sử cuộc gọi"
            android:textColor="@color/text_secondary"
            android:textSize="11.5sp" />
    </LinearLayout>

    <!-- Ghi chú -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        android:text="Ghi chú chi tiết:"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etIncidentNote"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@drawable/bg_rounded_spinner_border"
        android:gravity="top|start"
        android:hint="Ví dụ: Đã gọi khách 3 cuộc nhưng không nghe máy..."
        android:padding="10dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:textSize="12sp" />

    <!-- Action buttons -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmIncidentCancel"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/danger"
        android:text="⏱️ BẮT ĐẦU ĐẾM NGƯỢC 15P CẢNH BÁO MẤT ĐƠN"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        app:cornerRadius="10dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDismissIncident"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="4dp"
        android:text="Quay lại (Tiếp tục giao món)"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

</LinearLayout>
