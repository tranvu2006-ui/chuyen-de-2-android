<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="10dp"
    android:paddingHorizontal="4dp">

    <!-- Rank Badge (#1, #2, #3...) -->
    <TextView
        android:id="@+id/tvDishRank"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/bg_badge_orange"
        android:gravity="center"
        android:text="1"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Info Column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvDishRankName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tên món ăn"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDishRankSales"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="120 phần đã bán"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Price -->
    <TextView
        android:id="@+id/tvDishRankPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="55.000 đ"
        android:textColor="@color/primary"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
