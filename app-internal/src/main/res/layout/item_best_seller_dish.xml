<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="10dp"
    android:paddingHorizontal="4dp">

    <!-- Rank Badge (#1, #2, #3...) -->
    <TextView
        android:id="@+id/tvDishRank"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/bg_badge_orange"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="1" />

    <!-- Info Column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvDishRankName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#0F172A"
            android:textSize="13.5sp"
            android:textStyle="bold"
            tools:text="Tên món ăn" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                app:srcCompat="@drawable/ic_flame"
                app:tint="#EA580C" />

            <TextView
                android:id="@+id/tvDishRankSales"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="#64748B"
                android:textSize="11sp"
                tools:text="120 phần đã bán" />
        </LinearLayout>
    </LinearLayout>

    <!-- Price -->
    <TextView
        android:id="@+id/tvDishRankPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/primary"
        android:textSize="13.5sp"
        android:textStyle="bold"
        tools:text="55.000 đ" />
</LinearLayout>
