<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Material3.CardView.Elevated"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/border"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Header: Mã đơn + Chặng + Tag thanh toán + Ưu tiên -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvBundleOrderCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#DH-8801"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBundleSequenceTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_badge_blue"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="Chặng 1"
                android:textColor="@color/brand_blue"
                android:textSize="10sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvBundlePaymentBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_green"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="✓ VIETQR (0đ)"
                android:textColor="@color/brand_green"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Nút đổi thứ tự ưu tiên -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnTogglePriority"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_priority_active"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="⚡ Ưu tiên giao trước (1)"
                android:textColor="@color/brand_blue"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBundleOrderFee"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="+25.000 đ"
                android:textAlignment="textEnd"
                android:textColor="@color/brand_green"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="8dp"
            android:background="#F1F5F9" />

        <!-- Thông tin khách hàng & Điểm giao -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvBundleCustomerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Khách: An Nguyễn"
                    android:textColor="@color/text_primary"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvBundleDeliveryAddress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="📍 104 Hai Bà Trưng, P. Đa Kao, Q.1"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnCallBundleCustomer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_blue"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="📞 Gọi"
                android:textColor="@color/brand_blue"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Checklist món ăn -->
        <LinearLayout
            android:id="@+id/layoutBundleDishChecklist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#F8FAFC"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvBundleDishListText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• 1x Hồng Trà Đặc Biệt\n• 1x Trà Đào Cam Sả"
                android:textColor="#334155"
                android:textSize="11.5sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

        <!-- Ghi chú của khách -->
        <TextView
            android:id="@+id/tvBundleCustomerNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#FFFBEB"
            android:padding="6dp"
            android:text="📝 Ghi chú: Xin thêm ống hút to"
            android:textColor="#92400E"
            android:textSize="10.5sp"
            android:visibility="gone" />

        <!-- Checkbox xác nhận đủ món cho đơn này -->
        <CheckBox
            android:id="@+id/cbOrderReady"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:checked="true"
            android:text="Đã kiểm đủ món &amp; dán tem niêm phong đơn này"
            android:textColor="#059669"
            android:textSize="11.5sp"
            android:textStyle="bold" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
