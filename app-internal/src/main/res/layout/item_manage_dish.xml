<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Material3.CardView.Elevated"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Thumbnail ảnh món được bo góc mượt mà -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="74dp"
            android:layout_height="74dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/divider"
            app:strokeWidth="1dp">

            <ImageView
                android:id="@+id/ivDishThumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/divider"
                android:contentDescription="Ảnh món ăn"
                android:scaleType="centerCrop"
                tools:src="@drawable/bg_badge_orange" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Thông tin món -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDishName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="14.5sp"
                android:textStyle="bold"
                tools:text="Trà Xí Muội Ô Long" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvDishCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_blue"
                    android:ellipsize="end"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="2dp"
                    android:singleLine="true"
                    android:textColor="@color/brand_blue"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    tools:text="Trà Trái Cây" />

                <TextView
                    android:id="@+id/tvComboBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_badge_orange"
                    android:ellipsize="end"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="2dp"
                    android:singleLine="true"
                    android:text="✨ COMBO"
                    android:textColor="@color/primary"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDishDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:visibility="gone"
                tools:text="Ghi chú món ăn" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvDishPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/primary"
                    android:textSize="14.5sp"
                    android:textStyle="bold"
                    tools:text="28.000 đ" />

                <TextView
                    android:id="@+id/tvOriginalPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:text="35.000 đ"
                    tools:visibility="visible" />
            </LinearLayout>
        </LinearLayout>

        <!-- Nút Sửa & Xóa đồng bộ icon Lucide -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditDish"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="74dp"
                android:layout_height="32dp"
                android:backgroundTint="@color/brand_blue_bg"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="8dp"
                android:paddingTop="0dp"
                android:paddingEnd="8dp"
                android:paddingBottom="0dp"
                android:text="Sửa"
                android:textColor="@color/brand_blue"
                android:textSize="11sp"
                android:textStyle="bold"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_pencil"
                app:iconPadding="4dp"
                app:iconSize="13dp"
                app:iconTint="@color/brand_blue"
                app:strokeColor="#BFDBFE"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteDish"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="74dp"
                android:layout_height="32dp"
                android:layout_marginTop="6dp"
                android:backgroundTint="#FEF2F2"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="8dp"
                android:paddingTop="0dp"
                android:paddingEnd="8dp"
                android:paddingBottom="0dp"
                android:text="Xóa"
                android:textColor="#DC2626"
                android:textSize="11sp"
                android:textStyle="bold"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_trash"
                app:iconPadding="4dp"
                app:iconSize="13dp"
                app:iconTint="#DC2626"
                app:strokeColor="#FECACA"
                app:strokeWidth="1dp" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
