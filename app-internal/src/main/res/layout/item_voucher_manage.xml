<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvVoucherCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_orange"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="OISHI10"
                    android:textColor="@color/primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvVoucherDiscount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="-10.000 đ"
                    android:textColor="#16A34A"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvVoucherMinOrder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Đơn tối thiểu: 50.000 đ"
                android:textColor="#64748B"
                android:textSize="11.5sp" />
        </LinearLayout>

        <!-- Nút Sửa Voucher -->
        <ImageButton
            android:id="@+id/btnEditVoucher"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_btn_edit_dish"
            android:contentDescription="Sửa voucher"
            android:padding="8dp"
            app:srcCompat="@drawable/ic_edit"
            app:tint="@color/primary" />

        <!-- Nút Xóa Voucher -->
        <ImageButton
            android:id="@+id/btnDeleteVoucher"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_btn_delete_dish"
            android:contentDescription="Xóa voucher"
            android:padding="8dp"
            app:srcCompat="@drawable/ic_close"
            app:tint="#EF4444" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
