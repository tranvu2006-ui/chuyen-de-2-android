{
  "rules": {
    "roles": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'ADMIN'"
    },
    "user_statuses": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'ADMIN'"
    },
    "approval_statuses": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'ADMIN'"
    },
    "store_statuses": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'ADMIN'"
    },
    "penalty_tiers": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'ADMIN'"
    },
    "delivery_time_frames": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'ADMIN'"
    },
    "users": {
      ".indexOn": ["role", "status", "email"],
      ".read": "auth != null",
      "$userId": {
        ".write": "auth != null && (auth.uid == $userId || root.child('users').child(auth.uid).child('role').val() == 'ADMIN' || root.child('users').child(auth.uid).child('role').val() == 'MANAGER' || root.child('users').child(auth.uid).child('role').val() == 'MERCHANT')"
      }
    },
    "customers": {
      ".read": "auth != null",
      "$userId": {
        ".write": "auth != null && (auth.uid == $userId || root.child('users').child(auth.uid).child('role').val() == 'ADMIN' || root.child('users').child(auth.uid).child('role').val() == 'MERCHANT')"
      }
    },
    "merchants": {
      ".read": "auth != null",
      "$userId": {
        ".write": "auth != null && (auth.uid == $userId || root.child('users').child(auth.uid).child('role').val() == 'ADMIN' || root.child('users').child(auth.uid).child('role').val() == 'MERCHANT')"
      }
    },
    "bank_accounts": {
      ".indexOn": ["userId"],
      ".read": "auth != null",
      "$bankAccountId": {
        ".write": "auth != null && (data.child('userId').val() == auth.uid || newData.child('userId').val() == auth.uid || root.child('users').child(auth.uid).child('role').val() == 'ADMIN')"
      }
    },
    "drivers": {
      ".indexOn": ["dutyStatus", "storeId"],
      ".read": "auth != null",
      "$userId": {
        ".write": "auth != null && (auth.uid == $userId || root.child('users').child(auth.uid).child('role').val() == 'ADMIN' || root.child('users').child(auth.uid).child('role').val() == 'MANAGER' || root.child('users').child(auth.uid).child('role').val() == 'MERCHANT')"
      }
    },
    "stores": {
      ".read": true,
      ".write": "auth != null"
    },
    "carts": {
      "$userId": {
        ".read": "auth != null && auth.uid == $userId",
        ".write": "auth != null && auth.uid == $userId"
      }
    },
    "orders": {
      ".indexOn": ["customerId", "shipperId", "shopId", "status", "timestamp"],
      ".read": "auth != null",
      "$orderId": {
        ".write": "auth != null && ((data.exists() && newData.child('customerId').val() == data.child('customerId').val() && newData.child('total').val() == data.child('total').val() && newData.child('totalPayment').val() == data.child('totalPayment').val() && newData.child('paymentMethod').val() == data.child('paymentMethod').val() && newData.child('vnpTransactionNo').val() == data.child('vnpTransactionNo').val() && newData.child('vnpBankCode').val() == data.child('vnpBankCode').val() && newData.child('vnpPayDate').val() == data.child('vnpPayDate').val() && newData.child('vnpTxnRef').val() == data.child('vnpTxnRef').val() && newData.child('paidAt').val() == data.child('paidAt').val()) || (!data.exists() && newData.child('customerId').val() == auth.uid && !newData.child('vnpTransactionNo').exists() && !newData.child('vnpBankCode').exists() && !newData.child('vnpPayDate').exists() && !newData.child('vnpTxnRef').exists() && !newData.child('paidAt').exists() && ((newData.child('paymentMethod').val() == 'VNPAY' && newData.child('totalPayment').val() == 0) || (newData.child('paymentMethod').val() != 'VNPAY' && newData.child('totalPayment').val() == newData.child('total').val()))))"
      }
    },
    "tracking": {
      ".read": "auth != null",
      "$orderId": {
        ".write": "auth != null"
      }
    },
    "restaurants": {
      ".read": true,
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'ADMIN' || root.child('users').child(auth.uid).child('role').val() == 'MANAGER' || root.child('users').child(auth.uid).child('role').val() == 'MERCHANT')"
    },
    "menus": {
      ".read": true,
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'ADMIN' || root.child('users').child(auth.uid).child('role').val() == 'MANAGER' || root.child('users').child(auth.uid).child('role').val() == 'MERCHANT')"
    },
    "combos": {
      ".read": true,
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'ADMIN' || root.child('users').child(auth.uid).child('role').val() == 'MANAGER' || root.child('users').child(auth.uid).child('role').val() == 'MERCHANT')"
    },
    "dish_reviews": {
      ".indexOn": ["dishId", "orderId", "customerId"],
      ".read": true,
      "$reviewId": {
        ".write": "auth != null"
      }
    },
    "complaints": {
      ".read": "auth != null",
      "$complaintId": {
        ".write": "auth != null"
      }
    },
    "customer_addresses": {
      "$userId": {
        ".read": "auth != null && (auth.uid == $userId || root.child('users').child(auth.uid).child('role').val() == 'ADMIN')",
        ".write": "auth != null && (auth.uid == $userId || root.child('users').child(auth.uid).child('role').val() == 'ADMIN')"
      }
    },
    "trust_score_logs": {
      ".indexOn": ["customerId", "orderId"],
      ".read": "auth != null",
      "$logId": {
        ".write": "auth != null"
      }
    }
  }
}
