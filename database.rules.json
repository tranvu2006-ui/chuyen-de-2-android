{
  "rules": {
    "roles": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'ADMIN'"
    },
    "user_statuses": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'ADMIN'"
    },
    "approval_statuses": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'ADMIN'"
    },
    "store_statuses": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'ADMIN'"
    },
    "penalty_tiers": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'ADMIN'"
    },
    "delivery_time_frames": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'ADMIN'"
    },
    "users": {
      ".indexOn": ["role", "status"],
      ".read": "auth != null",
      "$userId": {
        ".write": "auth != null && (auth.uid == $userId || root.child('users').child(auth.uid).child('role').val() == 'MANAGER' || root.child('users').child(auth.uid).child('role').val() == 'MERCHANT')"
      }
    },
    "customers": {
      ".read": "auth != null",
      "$userId": {
        ".write": "auth != null && (auth.uid == $userId || root.child('users').child(auth.uid).child('role').val() == 'ADMIN')"
      }
    },
    "merchants": {
      ".read": "auth != null",
      "$userId": {
        ".write": "auth != null && (auth.uid == $userId || root.child('users').child(auth.uid).child('role').val() == 'ADMIN')"
      }
    },
    "bank_accounts": {
      ".indexOn": ["userId"],
      ".read": "auth != null",
      "$bankAccountId": {
        ".write": "auth != null && (data.child('userId').val() == auth.uid || newData.child('userId').val() == auth.uid || root.child('users').child(auth.uid).child('role').val() == 'ADMIN')"
      }
    },
    "drivers": {
      ".indexOn": ["dutyStatus", "storeId"],
      ".read": "auth != null",
      "$userId": {
        ".write": "auth != null && (auth.uid == $userId || root.child('users').child(auth.uid).child('role').val() == 'MANAGER' || root.child('users').child(auth.uid).child('role').val() == 'MERCHANT')"
      }
    },
    "stores": {
      ".read": true,
      ".write": "auth != null"
    },
    "carts": {
      "$userId": {
        ".read": "auth != null && auth.uid == $userId",
        ".write": "auth != null && auth.uid == $userId"
      }
    },
    "orders": {
      ".indexOn": ["customerId", "shipperId", "shopId", "status", "timestamp"],
      ".read": "auth != null",
      "$orderId": {
        ".write": "auth != null"
      }
    },
    "tracking": {
      ".read": "auth != null",
      "$orderId": {
        ".write": "auth != null"
      }
    },
    "restaurants": {
      ".read": true,
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'MANAGER' || root.child('users').child(auth.uid).child('role').val() == 'MERCHANT')"
    },
    "menus": {
      ".read": true,
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'MANAGER' || root.child('users').child(auth.uid).child('role').val() == 'MERCHANT')"
    },
    "combos": {
      ".read": true,
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'MANAGER' || root.child('users').child(auth.uid).child('role').val() == 'MERCHANT')"
    },
    "dish_reviews": {
      ".indexOn": ["dishId", "orderId", "customerId"],
      ".read": true,
      "$reviewId": {
        ".write": "auth != null"
      }
    },
    "complaints": {
      ".read": "auth != null",
      "$complaintId": {
        ".write": "auth != null"
      }
    }
  }
}
